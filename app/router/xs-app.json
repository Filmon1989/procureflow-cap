{
  "welcomeFile": "/com.procureflow.purchaseorders/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/com\\.procureflow\\.purchaseorders/(.*)$",
      "target": "$1",
      "localDir": "resources/com.procureflow.purchaseorders",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    }
  ]
}